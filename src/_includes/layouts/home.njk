{%- set ltrClass = ' class="ltr"' if lang == "ar" else "" -%}
{%- set otherPath = enPath if lang == "ar" else arPath -%}
{%- set projectSizes = "(max-width:720px) calc(100vw - 32px), (max-width:1480px) calc(100vw - 80px), 1400px" -%}
{%- set pairSizes = "(max-width:720px) calc(100vw - 32px), (max-width:1480px) calc(50vw - 72px), 668px" -%}
<!doctype html>
<html lang="{{ lang }}"{% if lang == "ar" %} dir="rtl"{% endif %}>
<head>
  <meta charset="utf-8" />
  <script>document.documentElement.classList.add('js')</script>
  <meta http-equiv="content-language" content="{{ lang }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#11100d" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.google.com" />
  <link rel="dns-prefetch" href="https://maps.googleapis.com" />
  <link rel="dns-prefetch" href="https://maps.gstatic.com" />
  <link rel="dns-prefetch" href="https://khms0.googleapis.com" />
  <link rel="dns-prefetch" href="https://khms1.googleapis.com" />
  <meta name="description" content="{{ t.meta.description }}" />
  <meta name="author" content="{{ t.meta.author }}" />
  <meta name="robots" content="index, follow" />
  <meta name="geo.region" content="SA-01" />
  <meta name="geo.placename" content="{{ t.meta.geoPlacename }}" />
  <meta name="geo.position" content="{{ site.latitude }};{{ site.longitude }}" />
  <meta name="ICBM" content="{{ site.latitude }}, {{ site.longitude }}" />
  <title>{{ t.meta.title }}</title>
{% include "partials/head-links.njk" %}
  <link rel="preload" as="image" href="/assets/images/commercial-golden.webp" imagesrcset="{{ 'commercial-golden' | srcset }}" imagesizes="100vw" fetchpriority="high" />
{% include "partials/font-preload.njk" %}
  <link rel="stylesheet" href="{{ '/styles.css' | versioned }}" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="{{ t.meta.siteName }}" />
  <meta property="og:title" content="{{ t.meta.title }}" />
  <meta property="og:description" content="{{ t.meta.ogDescription }}" />
  <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
  <meta property="og:image" content="{{ site.ogImage }}" />
  <meta property="og:image:alt" content="{{ t.meta.imageAlt }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:locale" content="{{ t.meta.locale }}" />
  <meta property="og:locale:alternate" content="{{ t.meta.localeAlternate }}" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ t.meta.title }}" />
  <meta name="twitter:description" content="{{ t.meta.twitterDescription }}" />
  <meta name="twitter:image" content="{{ site.ogImage }}" />
  <meta name="twitter:image:alt" content="{{ t.meta.imageAlt }}" />

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "@id": "{{ site.url }}/#studio",
        "name": {{ t.ld.name | dump | safe }},
        "alternateName": {{ t.ld.alternateName | dump | safe }},
        "url": "{{ site.url }}/",
        "logo": "{{ site.logo }}",
        "image": "{{ site.ogImage }}",
        "description": {{ t.ld.description | dump | safe }},
        "email": "{{ site.email }}",
        "telephone": "{{ site.phone }}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ t.ld.streetAddress | dump | safe }},
          "addressLocality": {{ t.ld.locality | dump | safe }},
          "addressRegion": {{ t.ld.region | dump | safe }},
          "postalCode": "{{ site.postcode }}",
          "addressCountry": "SA"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": {{ site.latitude }},
          "longitude": {{ site.longitude }}
        },
        "hasMap": "{{ site.directions }}",
        "areaServed": {
          "@type": "Country",
          "name": {{ t.ld.country | dump | safe }}
        },
        "sameAs": [
          "{{ site.x }}"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}/",
        "name": {{ t.ld.name | dump | safe }},
        "inLanguage": ["en", "ar"],
        "publisher": { "@id": "{{ site.url }}/#studio" }
      },
      {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}#webpage",
        "url": "{{ site.url }}{{ page.url }}",
        "name": {{ t.ld.pageName | dump | safe }},
        "inLanguage": "{{ lang }}",
        "isPartOf": { "@id": "{{ site.url }}/#website" },
        "about": { "@id": "{{ site.url }}/#studio" }
      }
    ]
  }
  </script>
</head>
<body>
  <div class="page-noise" aria-hidden="true"></div>

  <header class="site-header" id="top">
    <a class="brand" href="{{ page.url }}" aria-label="{{ t.brand.homeLabel }}">
      <img class="logo-white" src="/assets/images/CAMR-logo-white.png" alt="{{ t.brand.logoAlt }}" width="128" height="128" decoding="async" />
      <img class="logo-black" src="/assets/images/CAMR-logo-black.png" alt="" width="128" height="128" decoding="async" />
      <span class="brand-text"><b>{{ t.brand.name }}</b><small>{{ t.brand.tag }}</small></span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">
      <span class="menu-lines" aria-hidden="true"><i></i><i></i></span>
      <span class="sr-only" id="menu-toggle-label">{{ t.menu.open }}</span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="{{ t.menu.navLabel }}">
{%- for item in t.menu.items %}
      <a href="{{ item.href }}">{{ item.label }}</a>
{%- endfor %}
      <a href="{{ otherPath }}" hreflang="{{ t.otherLang.code }}" lang="{{ t.otherLang.code }}" class="nav-lang">{{ t.otherLang.label }}</a>
      <div class="nav-contact" aria-label="{{ t.menu.contactLabel }}">
        <a href="mailto:{{ site.email }}">{{ site.email | ltr(lang) }}</a>
        <a href="tel:{{ site.phone }}">{{ site.phoneDisplay | ltr(lang) }}</a>
        <a href="{{ site.directions }}" target="_blank" rel="noopener">{{ t.menu.directions }} <span>{{ t.arrow }}</span></a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero" aria-label="{{ t.hero.label }}">
      <div class="hero-slides" aria-hidden="true">
        <figure class="hero-slide is-active"><img src="/assets/images/commercial-golden.webp" srcset="{{ 'commercial-golden' | srcset }}" sizes="100vw" alt="{{ t.hero.slideAlts[0] }}" fetchpriority="high" width="1600" height="1600" decoding="async" /></figure>
        <figure class="hero-slide"><img data-src="/assets/images/residence-front.webp" data-srcset="{{ 'residence-front' | srcset }}" sizes="100vw" alt="{{ t.hero.slideAlts[1] }}" width="1600" height="1501" decoding="async" /></figure>
        <figure class="hero-slide"><img data-src="/assets/images/villa-street.webp" data-srcset="{{ 'villa-street' | srcset }}" sizes="100vw" alt="{{ t.hero.slideAlts[2] }}" width="1600" height="1600" decoding="async" /></figure>
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>

      <div class="hero-content shell">
        <p class="eyebrow">{{ t.hero.eyebrow }}</p>
        <h1>{{ t.hero.heading | safe }}</h1>
        <p class="hero-copy">{{ t.hero.copy }}</p>
        <div class="hero-actions">
          <a class="button button-light" href="#projects">{{ t.hero.explore }}</a>
          <a class="text-link" href="#studio">{{ t.hero.discover }} <span>{{ t.arrow }}</span></a>
        </div>
      </div>

      <div class="hero-meta shell" aria-hidden="true">
        <span>{{ t.hero.selected }}</span>
        <div class="hero-counter"><b id="slide-current">{{ "01" | ltr(lang) }}</b><i></i><span{{ ltrClass | safe }}>03</span></div>
      </div>
    </section>

    <section class="intro section shell" id="studio">
      <div class="section-kicker">{{ "01" | ltr(lang) }} · {{ t.studio.kicker }}</div>
      <div class="intro-grid">
        <h2>{{ t.studio.heading | safe }}</h2>
        <div class="intro-copy">
{%- for p in t.studio.paragraphs %}
          <p>{{ p }}</p>
{%- endfor %}
        </div>
      </div>
      <div class="principles" aria-label="{{ t.studio.principlesLabel }}">
{%- for principle in t.studio.principles %}
        <span>{{ ("0" + loop.index) | ltr(lang) }} / {{ principle }}</span>
{%- endfor %}
      </div>
    </section>

    <section class="projects section" id="projects">
      <div class="shell section-heading">
        <div class="section-kicker">{{ "02" | ltr(lang) }} · {{ t.projects.kicker }}</div>
        <h2>{{ t.projects.heading | safe }}</h2>
      </div>

      <div class="project-list shell">
        {%- set p = t.projects.residence %}
        <article class="project project-featured reveal">
          <button class="project-image" data-lightbox="/assets/images/residence-angle.webp" aria-label="{{ p.open }}" style="aspect-ratio:1741/1800;">
            <img src="/assets/images/residence-angle.webp" srcset="{{ 'residence-angle' | srcset }}" sizes="{{ projectSizes }}" alt="{{ p.alt }}" loading="lazy" width="1600" height="1654" decoding="async" />
          </button>
          <div class="project-info">
            <p>{{ p.category }}</p>
            <h3>{{ p.title }}</h3>
            <span>{{ p.summary }}</span>
          </div>
        </article>

        <div class="project-pair">
          {%- set p = t.projects.villas %}
          <article class="project reveal">
            <button class="project-image portrait" data-lightbox="/assets/images/villa-front.webp" aria-label="{{ p.open }}" style="aspect-ratio:1/1;">
              <img src="/assets/images/villa-front.webp" srcset="{{ 'villa-front' | srcset }}" sizes="{{ pairSizes }}" alt="{{ p.alt }}" loading="lazy" width="1600" height="1600" decoding="async" />
            </button>
            <div class="project-info">
              <p>{{ p.category }}</p>
              <h3>{{ p.title }}</h3>
              <span>{{ p.summary }}</span>
            </div>
          </article>
          {%- set p = t.projects.commercial %}

          <article class="project offset reveal">
            <button class="project-image portrait" data-lightbox="/assets/images/commercial-front.webp" aria-label="{{ p.open }}" style="aspect-ratio:1371/1148;">
              <img src="/assets/images/commercial-front.webp" srcset="{{ 'commercial-front' | srcset(1371) }}" sizes="{{ pairSizes }}" alt="{{ p.alt }}" loading="lazy" width="1371" height="1148" decoding="async" />
            </button>
            <div class="project-info">
              <p>{{ p.category }}</p>
              <h3>{{ p.title }}</h3>
              <span>{{ p.summary }}</span>
            </div>
          </article>
        </div>
        {%- set p = t.projects.floors %}

        <article class="project project-wide project-floors reveal">
          <button class="project-image cinematic" data-lightbox="/assets/images/residential-floors-01.webp" aria-label="{{ p.open }}" style="aspect-ratio:1920/2273;">
            <img src="/assets/images/residential-floors-01.webp" srcset="{{ 'residential-floors-01' | srcset }}" sizes="{{ projectSizes }}" alt="{{ p.alt }}" loading="lazy" width="1600" height="1894" decoding="async" />
          </button>
          <button class="project-image" data-lightbox="/assets/images/residential-floors-02.webp" aria-label="{{ p.openMore }}" style="aspect-ratio:1920/2482;">
            <img src="/assets/images/residential-floors-02.webp" srcset="{{ 'residential-floors-02' | srcset }}" sizes="{{ projectSizes }}" alt="{{ p.alt }}" loading="lazy" width="1600" height="2068" decoding="async" />
          </button>
          <div class="project-info horizontal">
            <div><p>{{ p.category }}</p><h3>{{ p.title }}</h3></div>
            <span>{{ p.summary }}</span>
          </div>
        </article>
      </div>
    </section>

    <section class="gallery-strip" aria-label="{{ t.gallery.label }}">
{%- for name in ["residence-street", "villa-street", "residence-wide", "commercial-golden"] %}
      <figure style="aspect-ratio:1/1;overflow:hidden;"><img src="/assets/images/{{ name }}.webp" srcset="{{ name | srcset }}" sizes="(max-width:1000px) 50vw, 25vw" alt="{{ t.gallery.alts[loop.index0] }}" loading="lazy" width="1600" height="1600" decoding="async" /></figure>
{%- endfor %}
    </section>

    <section class="interiors section shell" id="interiors">
      <div class="section-kicker">{{ "03" | ltr(lang) }} · {{ t.interiors.kicker }}</div>
      <div class="section-heading">
        <h2>{{ t.interiors.heading | safe }}</h2>
      </div>

      <div class="interior-grid">
{%- for height in [1486, 1508, 1486, 1486] %}
        <figure class="reveal" style="aspect-ratio:1920/1783;overflow:hidden;">
          <img src="/assets/images/interior-0{{ loop.index }}.webp" srcset="{{ ('interior-0' + loop.index) | srcset }}" sizes="{{ pairSizes }}" alt="{{ t.interiors.alts[loop.index0] }}" loading="lazy" width="1600" height="{{ height }}" decoding="async" />
        </figure>
{%- endfor %}
      </div>
    </section>

    <section class="services section shell" id="services">
      <div class="section-kicker">{{ "04" | ltr(lang) }} · {{ t.services.kicker }}</div>
      <div class="services-head">
        <h2>{{ t.services.heading | safe }}</h2>
        <p>{{ t.services.intro }}</p>
      </div>

      <div class="service-list">
{%- for service in t.services.items %}
        <article><span{{ ltrClass | safe }}>0{{ loop.index }}</span><h3>{{ service.title }}</h3><p>{{ service.text }}</p></article>
{%- endfor %}
      </div>
    </section>

    <section class="statement" aria-label="{{ t.statement.label }}">
      <img src="/assets/images/residence-front.webp" srcset="{{ 'residence-front' | srcset }}" sizes="100vw" alt="{{ t.statement.alt }}" loading="lazy" width="1600" height="1501" decoding="async" />
      <div class="statement-overlay"></div>
      <blockquote>{{ t.statement.quote | safe }}</blockquote>
    </section>

    <section class="contact section shell" id="contact">
      <div class="section-kicker">{{ "05" | ltr(lang) }} · {{ t.contact.kicker }}</div>
      <div class="contact-grid">
        <div>
          <p class="contact-label">{{ t.contact.label }}</p>
          <h2>{{ t.contact.heading | safe }}</h2>
        </div>
        <div class="contact-panel">
          <p>{{ t.contact.intro }}</p>
          <a class="button button-dark" href="{{ site.whatsapp }}" target="_blank" rel="noopener">{{ t.contact.button }}</a>
          <div class="contact-details">
            <a href="mailto:{{ site.email }}">{{ site.email | ltr(lang) }}</a>
            <a href="tel:{{ site.phone }}">{{ site.phoneDisplay | ltr(lang) }}</a>
            <a href="{{ site.directions }}" target="_blank" rel="noopener">{{ t.menu.directions }} <span>{{ t.arrow }}</span></a>
          </div>
        </div>
      </div>
      <div class="contact-map">
        <iframe data-src="{{ t.contact.mapSrc }}" title="{{ t.contact.mapTitle }}" width="600" height="450" style="border:0;" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        <noscript><iframe src="{{ t.contact.mapSrc }}" title="{{ t.contact.mapTitle }}" width="600" height="450" style="border:0;" allowfullscreen referrerpolicy="strict-origin-when-cross-origin" loading="lazy"></iframe></noscript>
      </div>
    </section>
  </main>

  <footer class="site-footer shell">
    <a class="footer-brand" href="{{ page.url }}">{{ t.brand.name }} <span>{{ t.brand.tag }}</span></a>
    <p>{{ t.footer.tagline }}</p>
    <p>© <span id="year"></span> {{ t.footer.studioName }} · <a href="{{ page.url }}privacy/">{{ t.footer.privacy }}</a></p>
    <address class="footer-info">
      <span>{{ t.footer.address }} {{ site.postcode | ltr(lang) }}</span>
      <a href="mailto:{{ site.email }}">{{ site.email | ltr(lang) }}</a>
      <a href="tel:{{ site.phone }}">{{ site.phoneDisplay | ltr(lang) }}</a>
      <a href="{{ site.x }}" target="_blank" rel="noopener">{{ t.footer.x }} {{ site.xHandle | ltr(lang) }}</a>
    </address>
  </footer>

  <dialog class="lightbox" id="lightbox" aria-label="{{ t.lightbox.label }}">
    <button class="lightbox-close" type="button" aria-label="{{ t.lightbox.close }}">×</button>
    <img alt="{{ t.lightbox.alt }}" />
  </dialog>

{% include "partials/analytics.njk" %}
  <script src="{{ '/script.js' | versioned }}"></script>

  <div class="fab-wrapper{% if lang == 'ar' %} fab-wrapper-rtl{% endif %}" aria-label="{{ t.fab.label }}">
    <a href="{{ site.whatsapp }}" target="_blank" rel="noopener" class="fab fab-whatsapp" aria-label="{{ t.fab.whatsapp }}">
      {% include "partials/icon-whatsapp.svg" %}
    </a>
    <a href="tel:{{ site.phone }}" class="fab fab-phone" aria-label="{{ t.fab.call }}">
      {% include "partials/icon-phone.svg" %}
    </a>
  </div>
</body>
</html>
